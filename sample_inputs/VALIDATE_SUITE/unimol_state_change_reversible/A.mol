##
# A molecule information file
#
# Three interfaces: one binding site and two interfaces with states.  `tag`
# exists only so the model holds an irreversible unimolecular state change,
# which is what makes the forwardRxns and backRxns index spaces differ.
##

Name    = A

# translational diffusion constants
D       = [10.0,10.0,10.0]

# rotational diffusion constants
Dr      = [0,0,0]

# Coordinates
COM     0.0000    0.0000    0.0000
site    0.0000    0.0000    1.0000
ser     0.0000    1.0000    0.0000
tag     1.0000    0.0000    0.0000

#bonds for visualization
bonds = 3
COM site
COM ser
COM tag

#State definitions
state = ser~U~P
state = tag~U~P
