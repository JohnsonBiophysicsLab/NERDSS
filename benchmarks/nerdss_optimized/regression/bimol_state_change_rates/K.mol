##
# Facilitator for the bimolecular state change, a point like A.
#
# kd exists only to give the model one ordinary bimolecular reaction:
# set_rMaxLimit() reads only ReactionType::bimolecular, and a model whose only
# bimolecular reaction is a state change keeps rMaxLimit at 0.
##

Name    = K

# translational diffusion constants
D       = [25.0,25.0,25.0]

# rotational diffusion constants
Dr      = [0.01,0.01,0.01]

COM      0.0000    0.0000    0.0000
k        0.0000    0.0000    0.0000
kd       0.0000    0.0000    0.0000
