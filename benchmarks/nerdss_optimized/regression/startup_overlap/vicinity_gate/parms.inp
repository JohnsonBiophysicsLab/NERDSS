# Startup overlap model for the vicinity gate.
#
# 20 P and 20 Q placed at random in a 30 nm box.  Each has one interface 0.5 nm
# from its center, and P(p) + Q(q) binds at sigma 5 nm, so a P and a Q overlap
# when their interfaces are less than 5 nm apart.  The centers of such a pair
# can be up to 6 nm apart.  nItr = 1: only the start is under test.

start parameters
    nItr = 1
    timeStep = 0.1
    timeWrite = 1
    trajWrite = 1000
    restartWrite = 1000
    pdbWrite = 1000
end parameters

start boundaries
    WaterBox = [30,30,30]
end boundaries

start molecules
    P : 20
    Q : 20
end molecules

start reactions
    P(p) + Q(q) <-> P(p!1).Q(q!1)
    onRate3Dka = 10
    offRatekb = 1
    sigma = 5.0
    norm1 = [0,0,1]
    norm2 = [0,0,1]
    assocAngles = [nan,nan,nan,nan,nan]
end reactions
