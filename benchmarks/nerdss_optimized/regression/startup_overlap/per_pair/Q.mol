##
# Q molecule information file
##

Name    = Q

# translational diffusion constants
D       = [10.0,10.0,10.0]

# rotational diffusion constants
Dr      = [0.1,0.1,0.1]

# q binds P's p.  r reacts with nothing, 3 nm out on the other side of the
# center, where it is never within sigma of a P that is not also near q.
COM     0.0000    0.0000    0.0000
q       0.5000    0.0000    0.0000
r      -3.0000    0.0000    0.0000

bonds = 2
COM q
COM r
