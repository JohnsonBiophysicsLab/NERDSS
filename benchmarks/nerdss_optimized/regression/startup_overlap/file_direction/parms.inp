# Startup overlap model for the -c pass, where the file molecule is always the
# first one compared.
#
# One P and one Q in a 100 nm box.  P(p) + Q(q) binds at sigma 1 nm and is
# listed first; P(p) + Q(s) binds at sigma 2.5 nm; Q's r reacts with nothing.
# nItr = 1: only the start is under test.

start parameters
    nItr = 1
    timeStep = 0.1
    timeWrite = 1
    trajWrite = 1000
    restartWrite = 1000
    pdbWrite = 1000
end parameters

start boundaries
    WaterBox = [100,100,100]
end boundaries

start molecules
    P : 1
    Q : 1
end molecules

start reactions
    P(p) + Q(q) <-> P(p!1).Q(q!1)
    onRate3Dka = 10
    offRatekb = 1
    sigma = 1.0
    norm1 = [0,0,1]
    norm2 = [0,0,1]
    assocAngles = [nan,nan,nan,nan,nan]

    P(p) + Q(s) <-> P(p!1).Q(s!1)
    onRate3Dka = 10
    offRatekb = 1
    sigma = 2.5
    norm1 = [0,0,1]
    norm2 = [0,0,1]
    assocAngles = [nan,nan,nan,nan,nan]
end reactions
