# Input file: VALIDATE_SUITE/hetTrimer stretched 5x along x for the MPI scaling
# benchmark (SCALING_2026-10-30.md).  Copy numbers are 5x the validation
# case, so the concentrations are the same; rates and .mol files unchanged.

start parameters
    nItr = 30000
    timestep = 0.3
    timeWrite = 5000
    trajWrite = 1000000
    restartWrite = 1000000
    fromRestart = false
    overlapSepLimit = 2.3
    scaleMaxDisplace = 30.0
    pdbWrite = 1000000
    transitionWrite = 5000
end parameters
start boundaries
    WaterBox = [1607.35, 321.47, 321.47] #nm: 5 x the validation box along x only (42 columns of rMaxLimit 37.6 nm), y and z unchanged
end boundaries

start molecules
    A : 1665
    B : 1665
    C : 1665
end molecules

start reactions
	    
    #Same sites - Dimer reactions
    A(a1) + B(b2) <-> A(a1!1).B(b2!1)
    onRate3Dka = 100.0000
    offRatekb = 1000.028
    norm1 = [0, 4.17774579, -6.75973469]
    norm2 = [0, 4.17774579, -6.75973469]
    sigma = 1.0
    assocAngles = [2.58801829,2.58801829,0,0,0]
    bindRadSameCom = 1.5
    loopCoopFactor = 0.0
    

    A(a2) + C(c1) <-> A(a2!1).C(c1!1)
    onRate3Dka = 100.0000
    offRatekb = 1000.028
    norm1 = [0, 4.17774579, -6.75973469]
    norm2 = [0, 4.17774579, -6.75973469]
    sigma = 1.0
    assocAngles = [2.58801829,2.58801829,0,0,0]
    bindRadSameCom = 1.5
    loopCoopFactor = 0.0

    C(c2) + B(b1) <-> C(c2!1).B(b1!1)
    onRate3Dka = 100.0000
    offRatekb = 1000.028
    norm1 = [0, 4.17774579, -6.75973469]
    norm2 = [0, 4.17774579, -6.75973469]
    sigma = 1.0
    assocAngles = [2.58801829,2.58801829,0,0,0]
    bindRadSameCom = 1.5
    loopCoopFactor = 0.0
    
end reactions
