##
# B: one site, 0.75 nm from the centre.  Monovalent, so no complex is ever
# larger than one A and four B and none spans a column.
##

Name = B
checkOverlap = true

# translational diffusion constants
D = [20.0, 20.0, 20.0]

# rotational diffusion constants
Dr = [0.5, 0.5, 0.5]

# Coordinates
COM   0.0000000   0.0000000   0.0000000
b     0.7500000   0.0000000   0.0000000

# bonds
bonds = 1
com b
