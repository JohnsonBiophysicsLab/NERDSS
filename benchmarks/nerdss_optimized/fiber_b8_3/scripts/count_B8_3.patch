+    long fiberSeen {0}, fiberBeyond {0};            // fiber pairs at the pre-cut; of those, beyond rMaxLimit
+    long reactAdmit {0}, reactAdmitBeyond {0};      // 1D reaction rule admits (would reach determine_1D's table)
