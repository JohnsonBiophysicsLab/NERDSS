+    double rMaxLimit {0};
+    bool beyond {false};
+    ~B83Counter() {
+        std::cerr << "B83_COUNT rMaxLimit=" << rMaxLimit << " fiber_seen=" << fiberSeen << " fiber_beyond=" << fiberBeyond
